<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Rendered Flutter Card Image (Pixel-perfect authentic Quran font) -->
    <ImageView
        android:id="@+id/widget_rendered_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <!-- Fallback Native Layout -->
    <LinearLayout
        android:id="@+id/widget_fallback_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_background"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layoutDirection="rtl">

        <!-- Header Row: Title & Surah Reference Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Title Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦ آية اليوم"
                android:textColor="#F3D295"
                android:fontFamily="@font/amiri"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Surah & Ayah Pill -->
            <TextView
                android:id="@+id/widget_ref_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_bg"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:paddingTop="2.5dp"
                android:paddingBottom="2.5dp"
                android:text="سورة طه · آية ١١٤"
                android:textColor="#FFD98E"
                android:fontFamily="@font/amiri"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtle Divider -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="6dp"
            android:background="#15FFFFFF" />

        <!-- Center: The Daily Ayah Text -->
        <TextView
            android:id="@+id/widget_verse_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="﴿ وَقُل رَّبِّ زِدْنِي عِلْمًا ﴾"
            android:textColor="#FAF7EE"
            android:fontFamily="@font/amiri_quran"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.25"
            android:ellipsize="end"
            android:maxLines="20" />

    </LinearLayout>
</FrameLayout>
