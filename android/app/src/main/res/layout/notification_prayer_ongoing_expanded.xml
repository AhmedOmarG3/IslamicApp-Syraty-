<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="2dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <!-- Row 1: Location Only -->
    <TextView
        android:id="@+id/ongoing_expanded_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="القاهرة"
        android:textColor="#A4B3AC"
        android:textSize="12sp" />

    <!-- Row 2: Next Prayer Name + Time + Countdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ongoing_expanded_next_prayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="العصر ٠٤:٠٦ م"
            android:textColor="#FFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ongoing_expanded_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  —  "
            android:textColor="#A4B3AC"
            android:textSize="14sp" />

        <Chronometer
            android:id="@+id/ongoing_expanded_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format="متبقي %s"
            android:textColor="#FFDF9A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ongoing_expanded_fallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="حان وقت الصلاة"
            android:textColor="#FFDF9A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Subtle divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#20FFFFFF" />

    <!-- Row 3: All 6 Prayer Times Horizontal Strip (Fajr, Shuruq, Dhuhr, Asr, Maghrib, Isha) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="6">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/ongoing_box_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/ongoing_name_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#C0D0C8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ongoing_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="٠٤:٣٥"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Shuruq -->
        <LinearLayout
            android:id="@+id/ongoing_box_shuruq"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/ongoing_name_shuruq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الشروق"
                android:textColor="#C0D0C8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ongoing_time_shuruq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="٠٦:٠١"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/ongoing_box_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/ongoing_name_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#C0D0C8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ongoing_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="١١:٥٨"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/ongoing_box_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/ongoing_name_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#C0D0C8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ongoing_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="٠٣:٢٦"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/ongoing_box_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/ongoing_name_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#C0D0C8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ongoing_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="٠٦:٠٤"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/ongoing_box_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/ongoing_name_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#C0D0C8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ongoing_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="٠٧:٢٢"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Row 4: Action Buttons (تحديث الموقع | افتح سيرتي) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ongoing_expanded_btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:text="تحديث الموقع"
            android:textColor="#8EF2CA"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ongoing_expanded_btn_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:text="افتح سيرتي"
            android:textColor="#E5C78A"
            android:textSize="12.5sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
